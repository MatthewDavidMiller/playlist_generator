<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Platform-neutral MVVM presentation logic for Playlist Generator.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <!--
    The About view shows the licence the application is actually distributed under, so it
    reads the repository's own LICENSE rather than a copy of its text kept in code.
  -->
  <ItemGroup>
    <EmbeddedResource
        Include="../../LICENSE"
        LogicalName="PlaylistGenerator.Presentation.LICENSE" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PlaylistGenerator.Core/PlaylistGenerator.Core.csproj" />
  </ItemGroup>
</Project>
