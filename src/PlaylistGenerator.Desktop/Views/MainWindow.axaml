<Window
    x:Class="PlaylistGenerator.Desktop.Views.MainWindow"
    x:DataType="vm:MainViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PlaylistGenerator.Presentation.ViewModels"
    Title="Playlist Generator"
    Width="1040"
    Height="780"
    MinWidth="360"
    MinHeight="420"
    Background="{DynamicResource AppBackgroundBrush}"
    Foreground="{DynamicResource TextPrimaryBrush}"
    WindowStartupLocation="CenterScreen"
    d:DesignWidth="1040"
    d:DesignHeight="780"
    mc:Ignorable="d">

  <!--
    Bindings use full paths from the window's view model rather than nested DataContext
    assignments, so every path is checked against the single x:DataType above at build time.

    Layout.IsCompact drives a "compact" style class on each element that has to change shape
    in a narrow window. The breakpoint itself lives in the view model, so the markup only
    declares which elements react to it.
  -->
  <Border
      Classes="frame"
      Classes.compact="{Binding Layout.IsCompact}"
      MaxWidth="{StaticResource ContentMaxWidth}">
    <DockPanel LastChildFill="True">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
        <StackPanel Spacing="4" VerticalAlignment="Center">
          <TextBlock
              Classes="display"
              Classes.compact="{Binding Layout.IsCompact}"
              Text="Playlist Generator" />
          <TextBlock
              Classes="subtitle"
              Classes.compact="{Binding Layout.IsCompact}"
              Text="Build VLC playlists and normalize audio locally." />
        </StackPanel>
        <Button
            Grid.Column="1"
            VerticalAlignment="Center"
            Command="{Binding ToggleThemeCommand}"
            ToolTip.Tip="Switch between the light and dark application themes">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon
                Width="16"
                Height="16"
                Data="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 2a8 8 0 0 1 0 16z" />

            <!-- The label is dropped before the header can crowd the title. -->
            <TextBlock
                Classes="button-label"
                Classes.compact="{Binding Layout.IsCompact}"
                VerticalAlignment="Center"
                Text="Theme" />
          </StackPanel>
        </Button>
      </Grid>

      <Border
          DockPanel.Dock="Bottom"
          Classes="card"
          Classes.compact="{Binding Layout.IsCompact}"
          Margin="0,16,0,0"
          Padding="16">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Border
              Classes="status-accent"
              Classes.error="{Binding Status.HasErrorDetails}" />
          <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Classes="status-message" Text="{Binding Status.Message}" />
            <Expander
                Header="Error details"
                IsVisible="{Binding Status.HasErrorDetails}">

              <!-- A stack trace or a long list of failed files must not push the window taller. -->
              <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Auto">
                <SelectableTextBlock
                    Classes="diagnostics"
                    Text="{Binding Status.ErrorDetails}" />
              </ScrollViewer>
            </Expander>
          </StackPanel>
        </Grid>
      </Border>

      <TabControl>
        <TabItem Header="Create playlist" Classes.compact="{Binding Layout.IsCompact}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <Border
                Classes="card"
                Classes.compact="{Binding Layout.IsCompact}"
                Margin="0,12,0,4"
                VerticalAlignment="Top">
              <StackPanel>
                <TextBlock Classes="section-title" Text="Shuffled interval playlist" />
                <TextBlock
                    Classes="section-caption"
                    Text="A special audio file is inserted after each complete group of tracks." />

                <TextBlock Classes="field-label" Text="Music folder" />
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <TextBox
                      PlaceholderText="/path/to/music"
                      Text="{Binding Playlist.SourceDirectory}" />
                  <Button
                      Classes="browse"
                      Classes.compact="{Binding Layout.IsCompact}"
                      Command="{Binding Playlist.BrowseSourceCommand}"
                      Content="Browse…" />
                </Grid>

                <TextBlock Classes="field-label" Text="Special audio file" />
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <TextBox
                      PlaceholderText="/path/to/station-id.mp3"
                      Text="{Binding Playlist.SpecialFile}" />
                  <Button
                      Classes="browse"
                      Classes.compact="{Binding Layout.IsCompact}"
                      Command="{Binding Playlist.BrowseSpecialFileCommand}"
                      Content="Browse…" />
                </Grid>

                <TextBlock Classes="field-label" Text="Insert after this many tracks" />
                <NumericUpDown
                    Minimum="1"
                    Maximum="100000"
                    Increment="1"
                    Value="{Binding Playlist.InsertEvery}" />

                <TextBlock Classes="field-label" Text="Playlist output" />
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <TextBox
                      PlaceholderText="/path/to/playlist.m3u8"
                      Text="{Binding Playlist.OutputPath}" />
                  <Button
                      Classes="browse"
                      Classes.compact="{Binding Layout.IsCompact}"
                      Command="{Binding Playlist.BrowseOutputCommand}"
                      Content="Browse…" />
                </Grid>

                <Button
                    Classes="primary"
                    Classes.compact="{Binding Layout.IsCompact}"
                    Margin="0,24,0,0"
                    Command="{Binding Playlist.GenerateCommand}"
                    Content="Create playlist" />
              </StackPanel>
            </Border>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Normalize volume" Classes.compact="{Binding Layout.IsCompact}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <Border
                Classes="card"
                Classes.compact="{Binding Layout.IsCompact}"
                Margin="0,12,0,4"
                VerticalAlignment="Top">
              <StackPanel>
                <TextBlock Classes="section-title" Text="Two-pass loudness normalization" />
                <TextBlock
                    Classes="section-caption"
                    Text="Creates Opus 160k copies. Source files are never changed." />

                <TextBlock Classes="field-label" Text="Source audio folder" />
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <TextBox
                      PlaceholderText="/path/to/audio"
                      Text="{Binding Normalization.SourceDirectory}" />
                  <Button
                      Classes="browse"
                      Classes.compact="{Binding Layout.IsCompact}"
                      Command="{Binding Normalization.BrowseSourceCommand}"
                      Content="Browse…" />
                </Grid>

                <TextBlock Classes="field-label" Text="Normalized output folder" />
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <TextBox
                      PlaceholderText="/path/to/audio-normalized"
                      Text="{Binding Normalization.OutputDirectory}" />
                  <Button
                      Classes="browse"
                      Classes.compact="{Binding Layout.IsCompact}"
                      Command="{Binding Normalization.BrowseOutputCommand}"
                      Content="Browse…" />
                </Grid>

                <TextBlock Classes="field-label" Text="Progress" />
                <ProgressBar
                    Minimum="0"
                    Maximum="{Binding Normalization.ProgressMaximum}"
                    Value="{Binding Normalization.ProgressValue}" />
                <TextBlock
                    Classes="caption"
                    Margin="0,10,0,0"
                    Text="{Binding Normalization.ProgressText}" />

                <!-- Tiles wrap, so the counts stay on screen at any width. -->
                <WrapPanel Margin="0,16,-10,-10">
                  <Border Classes="stat">
                    <StackPanel Spacing="2">
                      <TextBlock
                          Classes="stat-value"
                          Text="{Binding Normalization.NormalizedFileCount}" />
                      <TextBlock Classes="stat-label" Text="Normalized" />
                    </StackPanel>
                  </Border>
                  <Border Classes="stat">
                    <StackPanel Spacing="2">
                      <TextBlock
                          Classes="stat-value"
                          Text="{Binding Normalization.SkippedFileCount}" />
                      <TextBlock Classes="stat-label" Text="Skipped" />
                    </StackPanel>
                  </Border>
                  <Border Classes="stat">
                    <StackPanel Spacing="2">
                      <TextBlock
                          Classes="stat-value"
                          Classes.danger="{Binding Normalization.HasFailures}"
                          Text="{Binding Normalization.FailedFileCount}" />
                      <TextBlock Classes="stat-label" Text="Failed" />
                    </StackPanel>
                  </Border>
                </WrapPanel>

                <Button
                    Classes="primary"
                    Classes.compact="{Binding Layout.IsCompact}"
                    Margin="0,12,0,0"
                    Command="{Binding Normalization.NormalizeCommand}"
                    Content="Normalize volume" />

                <WrapPanel Margin="0,12,-8,-8">
                  <Button
                      Classes="transport"
                      Command="{Binding Normalization.PauseCommand}"
                      Content="Pause" />
                  <Button
                      Classes="transport"
                      Command="{Binding Normalization.ResumeCommand}"
                      Content="Resume" />
                  <Button
                      Classes="transport"
                      Command="{Binding Normalization.StopCommand}"
                      Content="Stop" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="About" Classes.compact="{Binding Layout.IsCompact}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <Border
                Classes="card"
                Classes.compact="{Binding Layout.IsCompact}"
                Margin="0,12,0,4"
                VerticalAlignment="Top">
              <StackPanel>
                <TextBlock Classes="section-title" Text="{Binding About.ApplicationName}" />
                <TextBlock
                    Classes="section-caption"
                    Text="{Binding About.Version, StringFormat='Version {0}'}" />

                <TextBlock Classes="field-label" Text="Copyright" />
                <TextBlock Text="{Binding About.Copyright}" TextWrapping="Wrap" />

                <TextBlock Classes="field-label" Text="Source code" />
                <!--
                  The address is the content of an explicit text block so that it wraps in a
                  narrow window instead of being clipped, and so the underline of the default
                  link presentation cannot hide the underscore in the repository name.
                -->
                <HyperlinkButton
                    NavigateUri="{Binding About.ProjectUrl}"
                    ToolTip.Tip="Open the project page in your browser">
                  <TextBlock Text="{Binding About.ProjectUrl}" TextWrapping="Wrap" />
                </HyperlinkButton>

                <TextBlock Classes="field-label" Text="{Binding About.LicenseName}" />

                <!--
                  The notice ships with the application, which is what the licence asks for.
                  It scrolls with the rest of the tab: a second scrolling region nested inside
                  this one makes wrapped text and an auto-hiding scrollbar remeasure forever.
                -->
                <Border Classes="inset">
                  <SelectableTextBlock
                      Classes="license"
                      Text="{Binding About.LicenseText}" />
                </Border>
              </StackPanel>
            </Border>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </DockPanel>
  </Border>
</Window>
