<Application
    x:Class="PlaylistGenerator.Desktop.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://PlaylistGenerator/Styles/Palette.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <!--
      Normal density rather than compact: the same interface has to work under a finger on a
      tablet, and the control styles set their own touch-sized minimums on top of it.
    -->
    <FluentTheme />
    <StyleInclude Source="avares://PlaylistGenerator/Styles/Controls.axaml" />
  </Application.Styles>
</Application>
