<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Every colour the application chooses for itself lives here, once per theme variant, so a
    view never hard-codes a value that only works in one theme. Fluent's own accent colours
    are overridden alongside them so built-in control states match the rest of the interface.
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFF4F5F9" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#FFF2F3F9" />
      <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#FFE2E5EE" />
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF15171E" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF5C6478" />
      <SolidColorBrush x:Key="AccentBrush" Color="#FF4F46E5" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF443CD1" />
      <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF3A32B8" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFE5E4FB" />
      <SolidColorBrush x:Key="AccentTextBrush" Color="#FF4338CA" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="DangerBrush" Color="#FFC0322B" />

      <!-- Fluent's own keys: secondary buttons sit on a card, so they stay quieter than it. -->
      <SolidColorBrush x:Key="ButtonBackground" Color="#FFF2F3F9" />
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFE8EAF3" />
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFDDE0EC" />
      <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FFE2E5EE" />
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FFD5D9E6" />
      <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#FFD5D9E6" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF0E1015" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#FF171A21" />
      <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#FF1E222C" />
      <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#FF2A2F3B" />
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF1F3F8" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFA3ABBD" />
      <SolidColorBrush x:Key="AccentBrush" Color="#FF5B5FE8" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF6E72EE" />
      <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF4B4FD6" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#FF272A46" />
      <SolidColorBrush x:Key="AccentTextBrush" Color="#FF9FA3FF" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="DangerBrush" Color="#FFF87171" />

      <SolidColorBrush x:Key="ButtonBackground" Color="#FF232833" />
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF2C323F" />
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF1E222C" />
      <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FF333947" />
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FF3E4557" />
      <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#FF333947" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Fluent derives control accents from these, so overriding them retints the theme. -->
  <Color x:Key="SystemAccentColor">#FF4F46E5</Color>
  <Color x:Key="SystemAccentColorLight1">#FF6B66EA</Color>
  <Color x:Key="SystemAccentColorLight2">#FF8B87F0</Color>
  <Color x:Key="SystemAccentColorLight3">#FFACA9F5</Color>
  <Color x:Key="SystemAccentColorDark1">#FF443CD1</Color>
  <Color x:Key="SystemAccentColorDark2">#FF3931AE</Color>
  <Color x:Key="SystemAccentColorDark3">#FF2D268C</Color>

  <!--
    Text measured in a single column stops being readable past roughly this width, so the
    content stops growing on a wide or high-resolution display instead of stretching.
  -->
  <x:Double x:Key="ContentMaxWidth">1180</x:Double>

  <CornerRadius x:Key="CardCornerRadius">14</CornerRadius>

  <!-- Fluent's own key: every built-in control rounds to this without a per-control style. -->
  <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
</ResourceDictionary>
